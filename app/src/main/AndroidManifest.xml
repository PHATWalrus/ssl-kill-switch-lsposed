<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSLKillSwitch">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppListActivity"
            android:exported="false"
            android:label="@string/select_apps" />

        <!-- libxposed v2 entry point -->
        <service
            android:name=".MainHook"
            android:exported="true"
            android:permission="io.github.libxposed.permission.ACCESS_SERVICE">
            <intent-filter>
                <action android:name="io.github.libxposed.action.MODULE_INIT" />
            </intent-filter>
        </service>

        <!-- LSPosed module metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Disable SSL certificate pinning (Java + Native/BoringSSL)" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

    </application>

</manifest>
